# Copy to server/.env and fill in. Every value has a working default except
# ANTHROPIC_API_KEY, which BUILDER=claude_code needs.

# --- App ----------------------------------------------------------------------
LOG_LEVEL=INFO
# Comma-separated origins allowed to call the API (the Vite dev server by default).
CORS_ORIGINS=http://localhost:5173
# SQLite file in server/var/ by default. Any SQLAlchemy async URL works.
# DATABASE_URL=sqlite+aiosqlite:///./var/app.db

# --- Builder: who writes the app ----------------------------------------------
# "claude_code" runs Claude Code through the Claude Agent SDK.
# "fake" writes a small starter app with no API calls: use it to try the UI for free.
BUILDER=claude_code
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=
# The model Claude Code builds with. claude-sonnet-5-5 costs less per build.
AGENT_MODEL=claude-opus-5-5
# How hard it thinks: low | medium | high | xhigh | max
AGENT_EFFORT=high
# Safety limits per build. A build stops when it hits any of them.
AGENT_MAX_TURNS=60
AGENT_MAX_BUDGET_USD=2.0
BUILD_TIMEOUT_SECONDS=900
# Builds that run at the same time. Claude Code plus `npm install` is heavy; 1 suits a small VM.
MAX_CONCURRENT_BUILDS=1
# Run the agent's shell commands in Claude Code's OS sandbox (Linux and macOS only;
# Linux needs bubblewrap and socat). deploy/setup.sh turns this on for you.
AGENT_SANDBOX=false

# --- Deployer: where apps go --------------------------------------------------
# Where the agent writes each project, and where finished apps are published.
# Defaults: server/var/workspaces and server/var/sites
# WORKSPACES_DIR=
# SITES_DIR=
# This server's public address. App links are {PUBLIC_BASE_URL}/apps/<slug>/ ...
# PUBLIC_BASE_URL=http://localhost:8000
# ... unless you give each app its own subdomain (needs wildcard DNS, see docs/deploy-vm.md):
# APP_URL_TEMPLATE=https://{slug}.apps.example.com
